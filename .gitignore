# Secrets (any .env file, also copies like ".env copy"; only the .env.example files are kept)
.env
.env*
!.env.example
*.pem
*.key
secrets/

# The lab's own settings (the settings page, each device's settings, table maps): config/local/
# holds only what the lab changed; the files above it are the defaults (docs/dev/places.md)
/config/local/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Downloaded programs (lab-os quest-view --install: scrcpy)
downloads/

# Data, recordings, models
logs/
*.log
recordings/
datasets/
data/
outputs/
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
# the wake word's models (3.7 MB) are needed offline (models/openwakeword/README.md)
!models/openwakeword/*.onnx
# the turn model (8.7 MB), for the end of a spoken question (models/smart-turn/README.md)
!models/smart-turn/*.onnx
wandb/

# Claude Code (per-machine)
.claude/settings.local.json

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
.idea/
