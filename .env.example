# Copy to .env (in the repo's top folder) and fill in real values. .env is gitignored — never
# commit it. Read when lab-os starts; variables already set in the shell win. Another place
# (lab-os serve --config <folder>) reads <folder>/.env instead (docs/places.md).

# Which venue profile to load (config/venues/<name>.yaml).
LAB_OS_VENUE=lab

# AI access (second act: Gemini Robotics-ER "look, then reach"; model router later).
GEMINI_API_KEY=fake-gemini-key
OPENAI_API_KEY=fake-openai-key
ANTHROPIC_API_KEY=fake-anthropic-key
